{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Athlete and coach profile information including purchased training plans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["atleta", "treinador"] },
        "purchasedPlans": { "type": "array" },
        "activePlan": { "type": "string" },
        "activeLevel": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Training plan payment confirmation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string", "enum": ["5K", "10K", "21K"] },
        "level": { "type": "string", "enum": ["zero", "jacorro", "limites"] },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["pix", "credit_card", "voucher"] },
        "status": { "type": "string", "enum": ["approved", "pending"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "planId", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Users and athlete training subscription status"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment confirmations for plan unlocks"
    }
  }
}
